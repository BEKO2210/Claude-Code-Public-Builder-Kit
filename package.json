{
  "name": "claude-code-public-builder-kit",
  "version": "0.1.0",
  "description": "Turn a one-line project idea into a structured, opinionated Markdown foundation for building with Claude Code.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "generate:example": "node scripts/build-example.js",
    "generate:examples": "node scripts/build-example.js",
    "audit:a11y": "node scripts/a11y-audit.js",
    "sync:assets": "node scripts/sync-docs-assets.js",
    "sync:assets:check": "node scripts/sync-docs-assets.js --check",
    "build:og": "node scripts/build-og.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^7.0.1",
    "express": "^4.19.2"
  },
  "license": "MIT",
  "devDependencies": {
    "axe-core": "^4.11.4",
    "jsdom": "^29.1.0"
  }
}
